<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:CellBlock_Code.Views"
             x:Class="CellBlock_Code.Views.StartPage"
             BackgroundColor="#050814"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#12171E" />
            <Setter Property="Stroke" Value="#37434B" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="LevelButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#12171E" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="BorderWidth" Value="2" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="HeightRequest" Value="50" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="16,20,16,44" RowSpacing="10">

            <!-- Title -->
            <VerticalStackLayout Spacing="4">
                <Label Text="PRISON BREAK" FontSize="34" CharacterSpacing="6"
                       TextColor="#FF6B1A" HorizontalOptions="Center" />
                <Label Text="CRACK THE CODE • ESCAPE THE PRISON" FontSize="11"
                       CharacterSpacing="2" TextColor="#8A97A0" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Prison photo with animation layers -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                <Grid IsClippedToBounds="True">
                    <Image x:Name="PrisonImage" Source="prison_locked.png" Aspect="AspectFill" />
                    <BoxView x:Name="FlashOverlay" Color="Red" Opacity="0" InputTransparent="True" />
                    <Label x:Name="LockLabel" Text="🔒" FontSize="80" Opacity="0" Scale="4"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Status card -->
            <Border x:Name="StatusCard" Grid.Row="2" Style="{StaticResource CardStyle}"
                    BackgroundColor="#111A1B" Padding="10,8" Opacity="0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="🔒" FontSize="28" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="CELL LOCKED" FontSize="18" FontAttributes="Bold"
                               CharacterSpacing="2" TextColor="#FF6B1A" />
                        <Label Text="Choose your security level to begin the escape."
                               FontSize="11" TextColor="#A7B0B6" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Difficulty levels + help -->
            <VerticalStackLayout x:Name="DifficultyPanel" Grid.Row="3" Spacing="8"
                     Opacity="0" InputTransparent="True">

                <Button ClassId="Easy" Text="EASY  •  8:00"
                        Style="{StaticResource LevelButton}"
                        TextColor="#4ADE80" BorderColor="#2ECC71" Clicked="OnDifficultyClicked" />

                <Button ClassId="Medium" Text="MEDIUM  •  5:00"
                        Style="{StaticResource LevelButton}"
                        TextColor="#FF8B47" BorderColor="#E0651F" Clicked="OnDifficultyClicked" />

                <Button ClassId="Hard" Text="HARD  •  2:00"
                        Style="{StaticResource LevelButton}"
                        TextColor="#FF5C5C" BorderColor="Red" Clicked="OnDifficultyClicked" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Text="❓  HOW TO PLAY" BackgroundColor="Transparent" TextColor="#A7B0B6"
                    BorderColor="#37434B" BorderWidth="2" CornerRadius="14" HeightRequest="40"
                    FontSize="13" Clicked="OnHowToPlayClicked" />
                    <Button Grid.Column="1" Text="🏆  LEADERBOARD" BackgroundColor="Transparent"
                    TextColor="#FFB300" BorderColor="#FFB300" BorderWidth="2" CornerRadius="14"
                    HeightRequest="40" FontSize="13" Clicked="OnLeaderboardClicked" />
                </Grid>
            </VerticalStackLayout>
        </Grid>

        <!-- Help screen (covers everything) -->
        <views:HowToPlayView x:Name="HowToPlay" IsVisible="False" />
    </Grid>
</ContentPage>