<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CellBlock_Code.Models"
             x:Class="CellBlock_Code.Views.LeaderboardPage"
             BackgroundColor="#050814"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16,20,16,32" RowSpacing="10">

        <VerticalStackLayout Spacing="4">
            <Label Text="🏆 TOP 20 ESCAPES" FontSize="26" CharacterSpacing="3"
                   TextColor="#FF6B1A" HorizontalOptions="Center" />
            <Label Text="THE BEST BREAKOUTS EVER RECORDED" FontSize="10" CharacterSpacing="2"
                   TextColor="#8A97A0" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" x:Name="ScoreList">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" Spacing="6">
                    <Label Text="🔒" FontSize="40" HorizontalOptions="Center" />
                    <Label Text="No escapes recorded yet." FontSize="14" TextColor="#A7B0B6"
                           HorizontalOptions="Center" />
                    <Label Text="Be the first to break out!" FontSize="12" TextColor="#8A97A0"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:LeaderboardRow">
                    <Border Stroke="{Binding RowStroke}" StrokeThickness="2" BackgroundColor="#12171E"
                            StrokeShape="RoundRectangle 12" Padding="10,8" Margin="0,0,0,6">
                        <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="8">
                            <Label Text="{Binding RankText}" FontSize="18" FontAttributes="Bold"
                                   TextColor="#FFB300" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding Username}" TextColor="White"
                                       FontAttributes="Bold" FontSize="15" />
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding Level}" TextColor="{Binding LevelColor}"
                                           FontSize="10" FontAttributes="Bold" />
                                    <Label Text="{Binding DateText}" TextColor="#8A97A0" FontSize="10" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{Binding Score}" FontSize="20"
                                   FontAttributes="Bold" TextColor="#FF6B1A" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <Button Text="←  CELL BLOCK" BackgroundColor="#12171E" TextColor="#A7B0B6"
                    BorderColor="#37434B" BorderWidth="2" CornerRadius="12" HeightRequest="44"
                    FontAttributes="Bold" Clicked="Back_Clicked" />
            <Button Grid.Column="1" Text="🗑  CLEAR" BackgroundColor="#12171E" TextColor="#FF5C5C"
                    BorderColor="#7A2A2A" BorderWidth="2" CornerRadius="12" HeightRequest="44"
                    Clicked="Clear_Clicked" />
        </Grid>
    </Grid>
</ContentPage>